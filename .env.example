# Copy to .env for local work. On Vercel, set these in Project Settings -> Environment Variables.

# PostgreSQL (Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used for migrations).
# With a plain local Postgres, use the same address for both.
DATABASE_URL=""
DIRECT_URL=""

# Vercel Blob (photos). Leave empty locally to keep photos in ./uploads.
# On Vercel it is added automatically when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=""

# The public address of the site (share-card links, sitemap). https://myproductshelf.com in production.
SITE_URL="https://my-product-shelf.vercel.app/"

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty locally.
NEXT_PUBLIC_GA_ID=""
